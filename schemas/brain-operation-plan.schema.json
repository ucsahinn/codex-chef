{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-chef.dev/schemas/brain-operation-plan.schema.json",
  "title": "Codex Chef Brain operation plan",
  "type": "object",
  "required": ["schemaVersion", "kind", "target", "approvalRequired"],
  "properties": {
    "schemaVersion": { "enum": ["codex-chef.brain-operation-plan.v1", "codex-chef.brain-backup-plan.v1", "codex-chef.brain-restore-plan.v1"] },
    "kind": { "enum": ["capture", "backup", "restore"] },
    "target": { "type": "string", "minLength": 3 },
    "approvalRequired": { "const": true }
  }
}
