{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-chef.dev/schemas/brain-note.schema.json",
  "title": "Codex Chef Brain canonical note frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["brain_schema", "id", "type", "title", "project_id", "status", "privacy", "confidence", "retention", "created", "updated", "source_refs"],
  "properties": {
    "brain_schema": { "const": "codex-chef.brain-note.v1" },
    "id": { "type": "string", "pattern": "^brn_[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" },
    "type": { "enum": ["capture", "project", "goal", "decision", "knowledge", "research", "profile", "preference", "active-thread", "session-summary"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,79}$" },
    "status": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "privacy": { "enum": ["public", "local", "restricted"] },
    "confidence": { "enum": ["confirmed", "observed", "inferred", "unverified"] },
    "retention": { "enum": ["permanent", "project", "review-90d", "ephemeral-30d"] },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "source_refs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 3, "maxLength": 500 } }
  }
}
