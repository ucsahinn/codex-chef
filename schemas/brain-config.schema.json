{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-chef.dev/schemas/brain-config.schema.json",
  "title": "Codex Chef Brain configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vaultName",
    "storageMode",
    "writePolicy",
    "semanticMemory",
    "directories"
  ],
  "properties": {
    "schemaVersion": { "const": "codex-chef.brain.v1" },
    "vaultName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "storageMode": { "const": "local-markdown" },
    "writePolicy": { "enum": ["preview-required", "manual-only"] },
    "semanticMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "provider"],
      "properties": {
        "enabled": { "const": false },
        "provider": { "const": "none" }
      }
    },
    "directories": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" }
    }
  }
}
